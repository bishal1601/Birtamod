@page
@model Birtamod.Web.Pages.PublicDashboard.IndexModel
@using Birtamod.Localization
@using Birtamod.Web.Menus
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<BirtamodResource> L
@{
    ViewBag.PageTitle = L["Menu:PublicDashboard"];
    PageLayout.Content.MenuItemName = BirtamodMenus.PublicDashboard;
}

<abp-card>
    <abp-card-header>
        <abp-card-title>@L["Menu:PublicDashboard"]</abp-card-title>
    </abp-card-header>
    <abp-card-body>
        <div class="mb-3">
            <label for="wardFilter" class="form-label">Ward Filter</label>
            <input id="wardFilter" class="form-control" placeholder="Ward Number (optional)" />
        </div>
        <div class="mb-3">
            <button class="btn btn-primary" id="loadDashboard">Load</button>
        </div>
        <div class="row mb-3" id="publicSummaryCards"></div>
        <canvas id="publicGenderChart" height="100"></canvas>
    </abp-card-body>
</abp-card>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <abp-script src="/Pages/PublicDashboard/index.js" />
}
